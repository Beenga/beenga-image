# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Replicate token. NOTE: the value currently in .env is an *organisation* token
# for `beenga`, not a personal one — check with
#   curl -sH "Authorization: Bearer $REPLICATE_API_TOKEN" \
#        https://api.replicate.com/v1/account
# which reports "type": "organization" or "user". The distinction matters:
# personal credit does NOT roll up to the org, and only the org token can push
# to or edit models under the beenga/ namespace.
REPLICATE_API_TOKEN=

# Personal account token (bkjha8), if you want benchmarking billed separately.
# Below $5 of credit, Replicate throttles prediction creation to 6/min with a
# burst of 1 — which looks like the model failing, but is not.
REPLICATE_PERSONAL_TOKEN=

# fal.ai. From fal.ai/dashboard/keys. Needed for `fal run` and `fal deploy`.
# The CLI reads this from the environment, so `set -a && . ./.env && set +a` is
# enough — no separate `fal auth login` required.
FAL_KEY=
