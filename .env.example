# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Personal account token (bkjha8). Has credit. Use for benchmarking and testing.
REPLICATE_API_TOKEN=

# Organisation token (beenga). Billed separately — personal credit does NOT roll up.
# Only needed for `cog push` and for running models under the beenga/ namespace.
# Add a payment method to the org before pushing, or the deploy fails at the last step.
REPLICATE_ORG_TOKEN=
